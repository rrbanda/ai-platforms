apiVersion: v1
kind: Secret
metadata:
  name: autorag-s3-connection
  namespace: autorag
type: Opaque
stringData:
  AWS_ACCESS_KEY_ID: "REPLACE_WITH_ACCESS_KEY"
  AWS_SECRET_ACCESS_KEY: "REPLACE_WITH_SECRET_KEY"
  AWS_S3_BUCKET: "REPLACE_WITH_BUCKET_NAME"
  AWS_S3_ENDPOINT: "REPLACE_WITH_S3_ENDPOINT"
  AWS_DEFAULT_REGION: "us-east-1"
