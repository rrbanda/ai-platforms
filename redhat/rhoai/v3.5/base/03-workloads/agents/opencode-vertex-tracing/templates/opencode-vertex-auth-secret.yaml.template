# Plain-text template — NEVER commit this file with real values.
# Run the commands below to produce sealed-opencode-vertex-auth.yaml, then commit that.
#
# The maas-api-key is an OpenShift ServiceAccount token that authenticates to
# the MaaS gateway (system:authenticated group has access). Token expires in
# ~1 year; regenerate with:
#   oc create token openshell-sandbox -n opencode-vertex-tracing --duration=8760h
#
# Usage:
#   kubeseal --fetch-cert \
#     --controller-namespace sealed-secrets \
#     --controller-name sealed-secrets-controller \
#     > /tmp/ss-cert.pem
#
#   MAAS_TOKEN=$(oc create token openshell-sandbox -n opencode-vertex-tracing --duration=8760h)
#   MLFLOW_TOKEN=$(oc whoami -t)
#
#   kubectl create secret generic opencode-vertex-auth \
#     --namespace opencode-vertex-tracing \
#     --from-literal=maas-api-key="$MAAS_TOKEN" \
#     --from-literal=jira-username="<YOUR_USERNAME>@redhat.com" \
#     --from-literal=jira-api-token="<YOUR_JIRA_API_TOKEN>" \
#     --from-literal=mlflow-tracking-token="$MLFLOW_TOKEN" \
#     --dry-run=client -o yaml \
#   | kubeseal --cert /tmp/ss-cert.pem --format yaml \
#     > ../sealed-opencode-vertex-auth.yaml
#
#   rm /tmp/ss-cert.pem
apiVersion: v1
kind: Secret
metadata:
  name: opencode-vertex-auth
  namespace: opencode-vertex-tracing
type: Opaque
stringData:
  maas-api-key: "REPLACE_WITH_SA_TOKEN"
  jira-username: "REPLACE_WITH_JIRA_USERNAME@redhat.com"
  jira-api-token: "REPLACE_WITH_JIRA_API_TOKEN"
  mlflow-tracking-token: "REPLACE_WITH_OC_WHOAMI_TOKEN"
