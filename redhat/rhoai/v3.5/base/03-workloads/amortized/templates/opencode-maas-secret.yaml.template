## Template for opencode-maas SealedSecret
## The maas-token is an OpenShift ServiceAccount token for amortized-server SA.
## It authenticates to the MaaS gateway (system:authenticated group has access).
## Token expires in ~1 year; regenerate with:
##   oc create token amortized-server -n amortized --duration=8760h
##
## To create/rotate:
##   TOKEN=$(oc create token amortized-server -n amortized --duration=8760h)
##   kubectl create secret generic opencode-maas -n amortized \
##     --from-literal=maas-token="$TOKEN" --dry-run=client -o yaml > /tmp/plain.yaml
##   kubeseal --cert /tmp/sealed-secrets-cert.pem --format yaml < /tmp/plain.yaml \
##     > overlays/sandbox1388/amortized/sealed-opencode-maas.yaml
##   shred -u /tmp/plain.yaml

apiVersion: v1
kind: Secret
metadata:
  name: opencode-maas
  namespace: amortized
type: Opaque
stringData:
  maas-token: "CHANGE_ME_oc_create_token_amortized-server"
